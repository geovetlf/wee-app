{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      ".env.local",
      ".secret.local",
      "test/**",
      "parche*.txt",
      "*.tmp.txt"
    ],
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9199,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": [
    {
      "site": "get-wee",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/landing.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy-policy.html"
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        },
        {
          "source": "/support",
          "destination": "/support.html"
        },
        {
          "source": "/post/**",
          "function": {
            "functionId": "publicPostPage",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "site": "wee-app",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
