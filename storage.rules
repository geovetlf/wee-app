rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // === Política contra la sobrescritura (línea A2 · activos-politicas) ===
    // Ningún cliente SOBRESCRIBE, CAMBIA ni BORRA un objeto. Cada subida de la app
    // crea un nombre nuevo (marca de tiempo + azar) y la regla lo exige con
    // `resource == null`: sobre un objeto que ya existe, la creación no se cumple y
    // la subida se deniega. `update` y `delete` van en `if false`. Quien borra es el
    // servidor con Admin SDK (`deleteAsset`, `burnViewOnce`), que no pasa por estas
    // reglas. Ver docs/ACTIVOS-POLITICA-STORAGE.md.
    //
    // === Imágenes de posts (legacy — nuevas subidas van a Cloudinary) ===
    // La lectura sigue pública: las publicaciones antiguas enlazan estas URLs.
    // Ninguna subida de la app actual escribe aquí; se conserva solo la creación
    // de nombres nuevos, para builds antiguos.
    match /images/posts/{userId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === Imágenes de perfil (legacy — nuevas subidas van a Cloudinary) ===
    // Misma política que las imágenes de posts: lectura pública, creación de nombres nuevos.
    match /images/profile/{userId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === Face-swap: selfie subida por el usuario ===
    match /users/{userId}/face-swap/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === AI Avatar generado por Cloud Function (lectura pública, escritura solo backend) ===
    match /users/{userId}/ai-avatar/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // === Resultado de avatar-replacement generado por Cloud Function ===
    // LA FOTO CON TU AVATAR ES TUYA, COMO EL SELFIE DEL QUE SALE.
    //
    // Decía `allow read: if true`: el selfie (`face-swap`) estaba protegido y la
    // foto que Weë hacía con él era de lectura —y de listado— libre para
    // cualquiera que conociera el uid. Ahora es como `ai-generations`: la lee y
    // la lista solo su dueño. Nadie más pierde nada: lo que la app enseña y
    // comparte es la URL de descarga CON TOKEN que devuelve `avatarReplacement`
    // (`uploadImageToStorage`), y esa URL no pasa por estas reglas.
    match /users/{userId}/avatar-replacement/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // === Resultados del WEË AI ENGINE (imágenes, videos, voces): lectura pública, escritura solo backend ===
    // LO QUE WEË GENERA ES DE SU DUEÑO, COMO LO QUE SUBE.
    //
    // Decía `allow read: if true`: la foto que la persona SUBÍA (creator-inputs)
    // estaba protegida y lo que Weë GENERABA con ella era de lectura libre para
    // cualquiera que adivinara la ruta. Al revés de lo que debe ser.
    //
    // La escritura sigue siendo del servidor. Y el borrado también, pero ahora
    // EXISTE: la persona lo pide con `deleteAsset` y el servidor comprueba que
    // es suyo antes de borrar el objeto. Antes `write: false` significaba
    // «nadie, nunca», y lo generado era permanente.
    match /users/{userId}/ai-generations/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // === Fotos que la persona sube para Weë Creator (Photo, Home, Beauty, Chef, Studio) ===
    // Sobre `resource == null`: la subida solo crea un nombre nuevo (ver la política arriba).
    match /users/{userId}/creator-inputs/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === Fotos adjuntas en Weë Brain ===
    match /users/{userId}/brain-attachments/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === WeeTalk: la foto que se ve una sola vez (Fase 11, C3) ===
    // La sube a su propia ruta quien la manda. La LEEN los participantes de
    // la conversación —se comprueba en Firestore desde aquí— y la BORRA el
    // servidor (`burnViewOnce`) cuando quien la recibe la abre. Antes iba a
    // Cloudinary, donde Weë no puede borrar nada, y se quedaba para siempre.
    function participaEn(conversationId) {
      let conversacion = /databases/(default)/documents/conversations/$(conversationId);
      // `exists` primero: una conversación que no existe deniega sin error de evaluación.
      return firestore.exists(conversacion)
        && (request.auth.uid in firestore.get(conversacion).data.participants
            || ("hidi_" + request.auth.uid) in firestore.get(conversacion).data.participants);
    }
    match /users/{userId}/weetalk/{conversationId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || participaEn(conversationId));
      // La foto se crea una vez: ni se sobrescribe ni se borra desde la app.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // === Documentos PDF de las publicaciones (R9 · D, aprobado por el dueño el 2026-10-13) ===
    // Los sube quien firma la publicación: `userId` es la cara que publica, la misma que `post.userId` —la real
    // (`<uid>`) o la Weë (`hidi_<uid>`), las dos de ESTA cuenta, igual que exige `firestore.rules` al crear un post—.
    // Solo PDF (`application/pdf`; el cliente comprueba además la cabecera `%PDF-` antes de subir) y hasta 10 MB.
    // Lectura pública, como las imágenes de posts: toda publicación de Weë es pública (`posts`: `allow read: if true`)
    // y el documento se abre desde la publicación. Ni se sobrescribe, ni se cambia, ni se borra desde la app (la
    // política de arriba); retirarlo es cosa del servidor.
    match /documents/posts/{userId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && (request.auth.uid == userId || ("hidi_" + request.auth.uid) == userId)
                    && resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    // Catch-all explícito: cualquier otra ruta queda denegada. Un `allow` que no
    // concede nada no cambia el resultado de las demás reglas.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
