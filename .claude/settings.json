{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(firebase deploy *)",
      "PowerShell(firebase deploy *)",
      "Bash(firebase.cmd deploy *)",
      "PowerShell(firebase.cmd deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(npx firebase-tools deploy *)",
      "Bash(firebase functions:delete *)",
      "PowerShell(firebase functions:delete *)",
      "Bash(firebase functions:secrets:set *)",
      "PowerShell(firebase functions:secrets:set *)",
      "Bash(firebase functions:secrets:destroy *)",
      "Bash(firebase hosting:disable *)",
      "Bash(firebase firestore:delete *)",
      "Bash(gcloud* * delete *)",
      "PowerShell(gcloud* * delete *)",
      "Bash(gcloud* * deploy *)",
      "PowerShell(gcloud* * deploy *)",
      "Bash(gcloud* secrets versions access *)",
      "PowerShell(gcloud* secrets versions access *)",
      "Bash(npm run deploy*)",
      "PowerShell(npm run deploy*)",
      "Bash(npm --prefix functions run deploy*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(vercel)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel deploy*)",
      "Bash(eas submit*)",
      "Bash(eas update*)",
      "Bash(npx eas submit*)",
      "Bash(npx eas update*)",
      "Bash(npx eas-cli submit*)",
      "Bash(npx eas-cli update*)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete *)",
      "Read(**/.env.local)",
      "Read(**/.secret.local)",
      "Read(**/.env.get-wee)",
      "Read(**/.env.prod)",
      "Read(**/application_default_credentials.json)",
      "Read(**/configstore/firebase-tools.json)",
      "Read(**/gha-creds-*.json)",
      "Read(**/*service-account*.json)",
      "Read(//c/Users/Geovet/wee-claves-retiradas/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo edit *)",
      "Bash(gh release create *)",
      "Bash(gcloud* * set-iam-policy *)",
      "PowerShell(gcloud* * set-iam-policy *)",
      "Bash(gcloud* * add-iam-policy-binding *)",
      "PowerShell(gcloud* * add-iam-policy-binding *)",
      "Bash(gcloud* * remove-iam-policy-binding *)",
      "PowerShell(gcloud* * remove-iam-policy-binding *)",
      "Bash(gcloud* * create *)",
      "PowerShell(gcloud* * create *)",
      "Bash(gcloud* * update *)",
      "PowerShell(gcloud* * update *)",
      "Bash(gcloud* services enable *)",
      "PowerShell(gcloud* services enable *)",
      "Bash(gcloud* secrets versions add *)",
      "Bash(gcloud* secrets versions disable *)",
      "Bash(gcloud* config set *)",
      "Bash(gcloud* auth print-access-token*)",
      "PowerShell(gcloud* auth print-access-token*)",
      "Edit(/.claude/**)",
      "Edit(/.firebaserc)",
      "Edit(/functions/src/credits/creditEngine.ts)",
      "Edit(/functions/src/core/financial/**)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git worktree list*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm --prefix functions run build)",
      "Bash(npm --prefix functions test)",
      "Bash(node functions/test/*)",
      "Bash(npm run functions:emulator)",
      "Bash(npm run web:demo*)",
      "Bash(npm ls*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh run view *)",
      "Bash(gh run list*)",
      "Bash(gh run watch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
