# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Temporary and backup files
nul
*.backup
*-backup.*
App-backup.tsx
app-backup.json

# Las huellas de copia de seguridad (scripts/copias.mjs, docs/BACKUP.md).
# Son hashes, pero también llevan identificadores REALES de producción —números
# de cuenta, ent_…, uid— para poder comparar una restauración. No se versionan.
.backup-local/

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Environment variables (IMPORTANT - don't upload credentials!)
.env
env.local
.env.production

# Service Account Keys (NEVER commit these!)
service-account.json
*-service-account.json
*.serviceaccount.json
functions/service-account.json

# Firebase config files with credentials
# GoogleService-Info.plist  # Needed for EAS Build
# google-services.json  # Needed for EAS Build
google-services.json.bak

# Claude Code local settings
.claude/settings.local.json
ios/
android/
.vercel

# Canvas ensamblado de la propuesta de diseño (se regenera desde los .dc.html)
design/canvas/propuesta-diseno-wee.html

# Secretos de producción de Cloud Functions (claves de IA, uids de administración): nunca versionar
functions/.env.get-wee
functions/.env.prod

# Compilado de Cloud Functions: sale de `npm --prefix functions run build` (predeploy y CI).
# Versionado se quedaba congelado (76ca834) y viajaba a producción con archivos huérfanos (auditoría H0).
functions/lib/

# Copias locales de entornos y configuración: nunca se versionan (auditoría H0).
.env.*
!.env.example
*.bak-*
*.antes-*
functions/parche*.txt
functions/.secret.local
hs_err_pid*.log

# Revisor de fase (docs/REVISION.md): la caché de revisiones de IA y las salidas intermedias de cada pasada.
# El informe final (ops/revision/informes/) y la baseline (ops/revision/baseline.json) sí se versionan.
ops/revision/.cache/
ops/revision/tmp/
# Salidas de la CI cuando se ejecuta en local (scripts/ci-local.mjs): el informe de la revisión determinista y los registros de políticas.
/revision-determinista.md
/politica-*.log
