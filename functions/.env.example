# Copia este archivo como functions/.env.local (no se versiona) para DESARROLLO LOCAL.
#
# EN PRODUCCIÓN las claves NO van en ningún archivo: se guardan en Cloud Secret Manager
# y se declaran en functions/src/secrets.ts con defineSecret. Para guardar o rotar una:
#   firebase functions:secrets:set ARK_API_KEY --project prod
# Firebase las expone a la función como variables de entorno con el mismo nombre, así que
# los adaptadores no cambian. functions.config() está obsoleto y no se usa.
# Clave de Google AI Studio (la misma variable que usa el avatar del perfil WEE).
GEMINI_API_KEY=
# Opcional: modelo de WEE Brain (por defecto gemini-2.5-flash)
# WEE_BRAIN_MODEL=gemini-2.5-flash

# ── WEË AI ENGINE (docs/AI-ENGINE.md): una clave por proveedor. Sin clave, el
# proveedor no existe para el router y todo sigue en modo prueba. ──
# Proveedores de esta fase: Gemini (texto, búsqueda, visión, imagen), Seedance vía BytePlus ModelArk (video), ElevenLabs (voz)
# GEMINI_TEXT_MODEL=gemini-3.8-flash          # opcional: ids de modelo de Gemini (ver ai.google.dev/gemini-api/docs/models)
# GEMINI_TEXT_MODEL_LITE=gemini-2.5-flash-lite
# GEMINI_TEXT_MODEL_PRO=gemini-3.1-pro-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image   # Nano Banana 2 (generación y edición de imágenes)
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image   # Nano Banana Pro (identidad: retoque, restauración, looks; también el avatar del Perfil Weë)
# GEMINI_IMAGE_MODEL_LITE=gemini-3.1-flash-lite-image  # Nano Banana 2 Lite (económico, solo 1K)
# GEMINI_MAX_INPUT_TOKENS=120000  # tope de tokens de entrada por peticion: por encima se rechaza en vez de generar a perdida
# STORAGE_BUCKET=               # opcional: bucket de Storage distinto al del proyecto
# LLM y visión / imagen "Nano Banana": la misma GEMINI_API_KEY de arriba
# ANTHROPIC_API_KEY=            # Claude (guiones, textos de calidad)
# OPENAI_API_KEY=               # OpenAI (LLM alternativo)
# OPENAI_MODEL=gpt-5.6-terra    # opcional: nombre del modelo principal
# OPENAI_MODEL_MINI=gpt-5.6-luna # opcional: modelo económico
# ── VIDEO (Weë Studio): SOLO la familia Seedance de ByteDance por la API oficial de BytePlus ModelArk ──
# ARK_API_KEY=                  # BytePlus ModelArk: Seedance 2.5 / 2.0 (video) y Seedream (imagen). Activa los modelos en la consola de BytePlus (saldo > USD 30, plan o paquete).
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_2_5_MODEL=dreamina-seedance-2-5-260628          # opcional: ids oficiales (docs.byteplus.com/en/docs/ModelArk)
# SEEDANCE_2_0_MODEL=dreamina-seedance-2-0-260128
# SEEDANCE_2_0_FAST_MODEL=dreamina-seedance-2-0-fast-260128
# SEEDANCE_2_0_MINI_MODEL=dreamina-seedance-2-0-mini-260615
# SEEDANCE_CALLBACK_URL=        # opcional en producción: URL pública de la función seedanceCallback (webhook); sin ella se usa sondeo
# SEEDANCE_CALLBACK_TOKEN=      # secreto que protege el webhook (se añade como ?token=)
# MINIMAX_API_KEY=              # MiniMax: voz (respaldo de ElevenLabs)
# MINIMAX_GROUP_ID=
# MINIMAX_VOICE_ID=Spanish_ReliableMan
# BFL_API_KEY=                  # FLUX (imagen)
# ELEVENLABS_API_KEY=           # ElevenLabs (voz)
# ELEVENLABS_VOICE_ID=          # importante: la voz de fábrica es inglesa; pon aquí una voz en español de tu cuenta
# Música: sin proveedor hasta tener API oficial con licencia comercial (no Suno)
# CREATOR_PRICING_MODE=simulated   # simulated (precios de prueba) | real (coste medido × Credits por USD)
# WEE_ADMIN_UIDS=                  # uids separados por coma que pueden llamar a engineAdmin y creditsAdmin
# En dev, functions/.env.wee-dev-geovet ya da permisos de administración al usuario de prueba;
# en producción crea functions/.env.get-wee (no versionado) con tu uid o usa el claim admin.

# ── CREDIT ENGINE (docs/CREDITS.md) ──
# CREDITS_WELCOME=240              # Credits de bienvenida al abrir la cuenta (0 desactiva)
# CREDITS_TEST_PURCHASES=true      # "Recarga de prueba" sin pago: true en dev/emulador; en producción false
# Pagos reales (pendientes de conectar; las claves nunca van en el cliente):
# APPLE_ISSUER_ID=                 # App Store Server API (App Store Connect)
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # cuenta de servicio con acceso a Google Play Developer API
# STRIPE_SECRET_KEY=               # pagos web
# STRIPE_WEBHOOK_SECRET=
