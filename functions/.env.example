# Copia este archivo como functions/.env.local (no se versiona) para usar Gemini en el emulador.
# Clave de Google AI Studio (la misma variable que usa el avatar del perfil WEE).
GEMINI_API_KEY=
# Opcional: modelo de WEE Brain (por defecto gemini-2.5-flash)
# WEE_BRAIN_MODEL=gemini-2.5-flash

# ── WEË AI ENGINE (docs/AI-ENGINE.md): una clave por proveedor. Sin clave, el
# proveedor no existe para el router y todo sigue en modo prueba. ──
# LLM y visión / imagen "Nano Banana" / video Veo: la misma GEMINI_API_KEY de arriba
# ANTHROPIC_API_KEY=            # Claude (guiones, textos de calidad)
# OPENAI_API_KEY=               # OpenAI (LLM alternativo)
# OPENAI_MODEL=gpt-5            # opcional: nombre del modelo principal
# OPENAI_MODEL_MINI=gpt-5-mini  # opcional: modelo económico
# ARK_API_KEY=                  # BytePlus ModelArk: Seedance (video) y Seedream (imagen)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# KLING_ACCESS_KEY=             # Kling (video)
# KLING_SECRET_KEY=
# MINIMAX_API_KEY=              # MiniMax: Hailuo (video) y voz
# MINIMAX_GROUP_ID=
# MINIMAX_VOICE_ID=Spanish_ReliableMan
# RUNWAY_API_KEY=               # Runway (video)
# BFL_API_KEY=                  # FLUX (imagen)
# ELEVENLABS_API_KEY=           # ElevenLabs (voz)
# ELEVENLABS_VOICE_ID=
# Música: sin proveedor hasta tener API oficial con licencia comercial (no Suno)
# CREATOR_PRICING_MODE=simulated   # simulated (precios de prueba) | real (coste medido × Credits por USD)
# WEE_ADMIN_UIDS=                  # uids separados por coma que pueden llamar a engineAdmin
