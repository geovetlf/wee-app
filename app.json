{
  "expo": {
    "name": "Weë",
    "slug": "hidetok-simple",
    "scheme": "wee",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "jsEngine": "hermes",
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "zone.wee.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#0A0A0A",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wee.zone",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "www.wee.zone",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": "1.0.0"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "zone.wee.app",
      "supportsTablet": false,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A",
        "dark": {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#0A0A0A",
      "associatedDomains": [
        "applinks:wee.zone",
        "applinks:www.wee.zone"
      ],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "NSCameraUsageDescription": "Weë necesita acceso a tu cámara para que puedas tomar fotos y usarlas en tus publicaciones, tu perfil, WeeTalk y Weë AI.",
        "NSMicrophoneUsageDescription": "Weë necesita acceso a tu micrófono para que puedas grabar y enviar audios en WeeTalk.",
        "NSPhotoLibraryUsageDescription": "Weë necesita acceso a tu galería para que puedas seleccionar fotos y videos para tus publicaciones, tu perfil, WeeTalk y Weë AI.",
        "NSPhotoLibraryAddUsageDescription": "Weë necesita permiso para guardar en tu galería las imágenes y los videos que descargas de Weë AI.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "2"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Weë - La comunidad del futuro",
      "shortName": "Weë",
      "description": "Weë es la red social de las personas que crean con Inteligencia Artificial: descubre, aprende, crea, comparte y conecta.",
      "backgroundColor": "#0A0A0A",
      "themeColor": "#F5B731",
      "orientation": "portrait-primary"
    },
    "extra": {
      "eas": {
        "projectId": "920ff7aa-c0a9-481d-82c0-4e3d57386175"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Weë necesita acceso a tu galería para que puedas seleccionar fotos y videos para tus publicaciones, tu perfil, WeeTalk y Weë AI.",
          "savePhotosPermission": "Weë necesita permiso para guardar en tu galería las imágenes y los videos que descargas de Weë AI.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5B731",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.600935858829-f92ar5236mquqjdnpumddlpkp87qqfdm"
        }
      ],
      "react-native-compressor",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Weë usa tu ubicación aproximada solo mientras la tienes abierta, para sugerirte lugares cercanos y tu zona cuando agregas una ubicación a una publicación. Tu ubicación exacta no se muestra públicamente.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "owner": "giacomogonzales20",
    "updates": {
      "enabled": false
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "da": "./locales/da.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "pt-BR": "./locales/pt-BR.json",
      "pt-PT": "./locales/pt-PT.json",
      "sv": "./locales/sv.json",
      "tr": "./locales/tr.json",
      "ru": "./locales/ru.json",
      "hi": "./locales/hi.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "ja": "./locales/ja.json"
    }
  }
}
