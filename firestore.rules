rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // Credit Engine (docs/CREDITS.md): el saldo vive en el perfil y SOLO lo
    // escribe el servidor (Cloud Functions). Ninguna escritura del cliente
    // puede crear, cambiar ni borrar estos campos.
    function creditFields() {
      return ['creditsBalance', 'creditsLifetimeEarned', 'creditsLifetimeSpent', 'creditsInitializedAt'];
    }
    function createsCreditFields() {
      return request.resource.data.keys().hasAny(creditFields());
    }
    function touchesCreditFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(creditFields());
    }

    // Encuestas (Bloque A): el campo `poll` de un post NO lo escribe el cliente.
    // Ni un tercero, ni el propio autor. Los contadores solo los mueve la callable
    // `votePoll`, que corre con el Admin SDK y no pasa por estas reglas. Publicar
    // la encuesta sigue siendo parte del `create` del post, que esto no toca.
    function touchesPoll() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll']);
    }

    // Un post publicado desde un perfil Biz pertenece a la PERSONA dueña del
    // negocio, no a "cualquiera que tenga cuenta". El id del negocio viaja dentro
    // del propio userId (`biz_<businessId>`) y el dueño está en `businesses`.
    // `exists()` antes de `get()` para que un negocio borrado deniegue en vez de
    // reventar la regla.
    function businessIdOf(userId) {
      return userId.split('biz_')[1];
    }
    function ownsBizProfile(userId) {
      return userId.matches('biz_.*') &&
        exists(/databases/$(database)/documents/businesses/$(businessIdOf(userId))) &&
        get(/databases/$(database)/documents/businesses/$(businessIdOf(userId))).data.ownerId == request.auth.uid;
    }
    // Autoría real de un post, para las tres identidades de una misma cuenta.
    function ownsPost() {
      return resource.data.userId == request.auth.uid ||
        resource.data.userId == ("hidi_" + request.auth.uid) ||
        ownsBizProfile(resource.data.userId);
    }

    // === USUARIOS ===
    match /users/{userId} {
      // Cualquiera puede leer perfiles públicos
      allow read: if true;

      // Solo el dueño puede crear/actualizar su perfil
      // Permite crear perfil real (uid == auth.uid), HIDI (uid == "hidi_" + auth.uid), o BIZ (uid starts with "biz_")
      allow create: if isAuthenticated() && !createsCreditFields() &&
        (request.auth.uid == request.resource.data.uid ||
         (request.resource.data.uid == ("hidi_" + request.auth.uid) &&
          request.resource.data.profileType == 'hidi' &&
          request.resource.data.linkedAccountId == request.auth.uid) ||
         (request.resource.data.profileType == 'biz' &&
          request.resource.data.linkedAccountId == request.auth.uid));

      allow update: if isAuthenticated() && !touchesCreditFields() &&
        (request.auth.uid == resource.data.uid ||
         (resource.data.uid == ("hidi_" + request.auth.uid) &&
          resource.data.profileType == 'hidi') ||
         (resource.data.profileType == 'biz' &&
          resource.data.linkedAccountId == request.auth.uid) ||
         // Permitir actualizar solo contadores de follows
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['followers', 'following']));

      allow delete: if false; // No permitir eliminar usuarios

      // Guardados: solo el dueño lee y escribe sus marcadores
      match /bookmarks/{postId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // "Mis documentos" de Weë Writer: solo el dueño
      match /writerDocuments/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // === COMUNIDADES ===
    match /communities/{communityId} {
      // Cualquiera puede leer comunidades
      allow read: if true;

      // Solo usuarios autenticados pueden crear comunidades
      allow create: if isAuthenticated();

      // Solo moderadores pueden actualizar la comunidad
      // O cualquier usuario autenticado puede actualizar contadores
      allow update: if isAuthenticated() &&
        (request.auth.uid in resource.data.moderators ||
         resource.data.createdBy == request.auth.uid ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['memberCount', 'postCount', 'updatedAt']));

      allow delete: if false; // No permitir eliminar comunidades

      // Subcolección de miembros (real o HIDI)
      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId);
        allow update: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId);
        allow delete: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId);
      }
    }

    // === POSTS ===
    match /posts/{postId} {
      // Cualquiera puede leer posts públicos
      allow read: if true;

      // Solo usuarios autenticados pueden crear posts.
      // Se publica con la identidad real, con la Weë (hidi) o con la de un negocio,
      // pero SIEMPRE tienen que ser identidades de esta misma cuenta: publicar como
      // `biz_<negocio>` exige ser la persona dueña de ese negocio.
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid) ||
         ownsBizProfile(request.resource.data.userId));

      // El autor puede actualizar su post, o cualquier usuario autenticado puede actualizar contadores.
      // `poll` queda fuera de los dos caminos: los votos solo los escribe el servidor.
      allow update: if isAuthenticated() && !touchesPoll() && (
        ownsPost() ||
        // Permitir actualizar solo contadores (views, agreementCount, etc.)
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'agreementCount', 'disagreementCount', 'likes', 'comments', 'shares', 'reposts', 'updatedAt'])
      );

      // Solo el autor puede eliminar su post
      allow delete: if isAuthenticated() && ownsPost();

      // === ENCUESTAS: el voto de cada persona, en su propio documento ===
      // Lo escribe únicamente la callable `votePoll` (Admin SDK). Cada quien lee
      // el suyo y solo el suyo: nadie puede saber qué votó otra persona.
      match /pollVotes/{voterUid} {
        allow read: if isAuthenticated() && request.auth.uid == voterUid;
        allow write: if false;
      }
    }

    // === VOTOS ===
    match /votes/{voteId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid) ||
         request.resource.data.userId.matches('biz_.*'));
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
    }

    // === VOTOS DE COMENTARIOS ===
    match /commentVotes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid) ||
         request.resource.data.userId.matches('biz_.*'));
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
    }

    // === COMENTARIOS ===
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid) ||
         request.resource.data.userId.matches('biz_.*'));

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == ("hidi_" + request.auth.uid) ||
        resource.data.userId.matches('biz_.*') ||
        // Permitir actualizar contadores
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'agreementCount', 'disagreementCount'])
      );

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
    }

    // === LIKES (legacy, mantener para retrocompatibilidad) ===
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid) ||
         request.resource.data.userId.matches('biz_.*'));
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid) ||
         resource.data.userId.matches('biz_.*'));
    }

    // === FOLLOWS ===
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.followerId == request.auth.uid ||
         request.resource.data.followerId == ("hidi_" + request.auth.uid) ||
         request.resource.data.followerId.matches('biz_.*'));
      allow delete: if isAuthenticated() &&
        (resource.data.followerId == request.auth.uid ||
         resource.data.followerId == ("hidi_" + request.auth.uid) ||
         resource.data.followerId.matches('biz_.*'));
    }

    // === CONVERSACIONES ===
    match /conversations/{conversationId} {
      // Solo participantes pueden leer
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants ||
         ("hidi_" + request.auth.uid) in resource.data.participants);

      // Solo usuarios autenticados que se incluyan a sí mismos en participants
      allow create: if isAuthenticated() &&
        (request.auth.uid in request.resource.data.participants ||
         ("hidi_" + request.auth.uid) in request.resource.data.participants);

      // Solo participantes pueden actualizar
      allow update: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants ||
         ("hidi_" + request.auth.uid) in resource.data.participants);

      allow delete: if false;

      // Mensajes dentro de conversaciones — solo participantes de la conversación padre
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
           ("hidi_" + request.auth.uid) in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow create: if isAuthenticated() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
           ("hidi_" + request.auth.uid) in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          (request.resource.data.senderId == request.auth.uid ||
           request.resource.data.senderId == ("hidi_" + request.auth.uid) ||
           request.resource.data.senderId.matches('biz_.*'));

        // Permitir marcar como leído (actualizar status) por cualquier participante
        allow update: if isAuthenticated() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
           ("hidi_" + request.auth.uid) in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow delete: if false;
      }
    }

    // === REPORTES ===
    match /reports/{reportId} {
      // Solo el reporter puede crear, nadie puede leer (solo admin via console)
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // === BUSINESS FOLLOWS (WeeBiz) ===
    match /businessFollows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // === BUSINESSES (WeeBiz) ===
    match /businesses/{businessId} {
      // Cualquiera puede leer negocios
      allow read: if true;

      // Solo usuarios autenticados pueden crear un negocio
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      // Solo el dueño puede actualizar su negocio, o cualquiera puede actualizar contadores
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followersCount', 'auraScore', 'reviewCount'])
      );

      allow delete: if false;

      // Reseñas del negocio
      match /reviews/{reviewId} {
        allow read: if true;

        // Solo usuarios autenticados pueden crear una reseña (no el dueño a sí mismo)
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;

        // Solo el autor puede eliminar su reseña
        allow delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;

        allow update: if false;
      }

      // Productos del negocio
      match /products/{productId} {
        allow read: if true;

        // Solo el dueño del negocio puede crear/editar/eliminar productos
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }
    }

    // === CREDIT ENGINE (docs/CREDITS.md) ===
    // Historial de Credits: cada persona lee el suyo; escribe solo el servidor.
    match /creditTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // Acumulados para administración: solo servidor / consola
    match /creditStats/{statId} {
      allow read, write: if false;
    }
    // Sobreescritura de costos (administración): la app los consulta por Cloud Function
    match /creditCosts/{costId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // === WALLETS / TRANSACTIONS (billetera anterior, solo lectura) ===
    // Migrada al Credit Engine (users.creditsBalance + creditTransactions).
    // Se conserva de solo lectura hasta que la migración termine; nadie escribe.
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && request.auth.uid == walletId;
      allow write: if false;
    }
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === NOTIFICACIONES ===
    match /notifications/{notificationId} {
      // Solo el destinatario puede leer sus notificaciones (real, HIDI o BIZ)
      allow read: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid) ||
         resource.data.recipientId.matches('biz_.*'));

      // Usuarios autenticados pueden crear notificaciones
      allow create: if isAuthenticated();

      // Solo el destinatario puede actualizar (marcar como leída)
      allow update: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid) ||
         resource.data.recipientId.matches('biz_.*'));

      // Solo el destinatario puede eliminar sus notificaciones
      allow delete: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid) ||
         resource.data.recipientId.matches('biz_.*'));
    }

    // === INTERÉS EN AI APPS (WEE Creator: "Avísame cuando esté") ===
    // Un documento por persona y categoría: {uid}_{categoryId}
    match /creatorInterests/{interestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        interestId == request.auth.uid + '_' + request.resource.data.categoryId;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // === WEE CREATOR: TRABAJOS ===
    // Los escribe solo el servidor (Cloud Functions); la persona lee los suyos.
    match /creatorJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      // La persona solo puede mover su creación a un proyecto
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectId', 'updatedAt']);

      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Catálogo y precios de WEE Creator: solo servidor / consola
    match /capabilities/{capabilityId} {
      allow read, write: if false;
    }
    match /pricing/{capabilityId} {
      allow read, write: if false;
    }

    // === WEË AI ENGINE (docs/AI-ENGINE.md) ===
    // Configuración de proveedores, cadenas de fallback y ajustes: solo servidor / consola
    match /aiProviders/{providerId} {
      allow read, write: if false;
    }
    match /aiRouting/{capabilityId} {
      allow read, write: if false;
    }
    match /aiSettings/{settingId} {
      allow read, write: if false;
    }
    match /aiUsage/{day} {
      allow read, write: if false;
    }
    // Libro de generaciones: cada persona lee las suyas; escribe solo el servidor
    match /aiGenerations/{generationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // Límites de uso por persona y día: solo servidor
    match /aiRateLimits/{limitId} {
      allow read, write: if false;
    }
    // Avisos del webhook de Seedance (BytePlus): los escribe la Cloud Function con
    // el Admin SDK, que no pasa por estas reglas. El cliente no lee ni escribe.
    match /aiProviderCallbacks/{taskId} {
      allow read, write: if false;
    }
    // Verificación de proveedores contra su API real: solo servidor y panel de administración
    match /aiProviderVerification/{providerId} {
      allow read, write: if false;
    }

    // === WEË BRAIN: conversaciones ===
    // La persona lee sus conversaciones y mensajes; escribe solo el servidor (brainChat)
    match /brainChats/{chatId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/brainChats/$(chatId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // === WEË CREATOR: PROYECTOS ("Mis proyectos") ===
    match /creatorProjects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
