rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // Credit Engine (docs/CREDITS.md): el saldo vive en el perfil y SOLO lo
    // escribe el servidor (Cloud Functions). Ninguna escritura del cliente
    // puede crear, cambiar ni borrar estos campos.
    function creditFields() {
      return ['creditsBalance', 'creditsLifetimeEarned', 'creditsLifetimeSpent', 'creditsInitializedAt'];
    }
    function createsCreditFields() {
      return request.resource.data.keys().hasAny(creditFields());
    }
    function touchesCreditFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(creditFields());
    }

    // ËContact: el número de conexiones de una persona lo cuenta el servidor, no
    // ella. Se protege igual que el saldo de Credits, y por lo mismo: un contador
    // que su dueño puede escribir no es un contador, es un campo de texto.
    function econtactFields() {
      return ['econtactsCount'];
    }
    function createsEcontactFields() {
      return request.resource.data.keys().hasAny(econtactFields());
    }
    function touchesEcontactFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(econtactFields());
    }

    // LO DE LA CUENTA NO VA EN EL PERFIL PÚBLICO. `users/{id}` lo lee cualquiera,
    // así que ningún cliente puede volver a escribir ahí un email, un nombre
    // real, una fecha de nacimiento, un género ni un token de push: lo privado
    // vive en `users/{id}/private/account` y el token en `pushTokens/{uid}`.
    // Los documentos antiguos que aún llevan estos campos se limpian con
    // `scripts/limpiar-cuenta-en-users.mjs`, con autorización aparte.
    function accountFields() {
      return ['email', 'realName', 'birthDate', 'gender', 'pushToken', 'pushTokenUpdatedAt'];
    }
    function createsAccountFields() {
      return request.resource.data.keys().hasAny(accountFields());
    }
    function touchesAccountFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(accountFields());
    }

    // LOS NÚMEROS Y LAS ENTIDADES DEL IDENTITY CORE LOS PONE EL SERVIDOR
    // (Fase 11.x-4A). El número de cuenta, el de la billetera, la entidad y su
    // dueño se asignan al nacer la cuenta, en una transacción del servidor. Si
    // un cliente pudiera escribirlos antes en su perfil, el día que el servidor
    // los lea encontraría uno inventado: por eso ningún cliente los escribe,
    // ni al crear ni al actualizar, aunque hoy nadie los lea todavía.
    function identityCoreFields() {
      return ['accountId', 'accountNumber', 'walletNumber', 'entityId', 'entityType', 'entitySequence', 'ownerAccountId'];
    }
    function createsIdentityCoreFields() {
      return request.resource.data.keys().hasAny(identityCoreFields());
    }
    function touchesIdentityCoreFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(identityCoreFields());
    }

    // LA IDENTIDAD DE UN PERFIL NO SE REESCRIBE (Fase 11.x). `uid` y
    // `profileType` son inmutables: antes el dueño podía ponerle a su
    // documento el uid de otra persona y colarse delante de su perfil en toda
    // consulta por `uid`. La única excepción es añadir `profileType: 'real'` a
    // un perfil antiguo que no lo tenía. Y `linkedAccountId` solo puede pasar
    // a apuntar a la propia cara Weë de la cuenta, o quedarse como está.
    function identityFields() {
      return ['uid', 'profileType'];
    }
    function anadeProfileTypeReal() {
      return !('profileType' in resource.data) && request.resource.data.profileType == 'real' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
    }
    function touchesIdentityFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(identityFields()) && !anadeProfileTypeReal();
    }
    function linkedAccountIdValido() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedAccountId']) ||
        (resource.data.uid == request.auth.uid && request.resource.data.linkedAccountId == ("hidi_" + request.auth.uid));
    }

    // UN CONTADOR SOLO PUEDE MOVERSE DE UNO EN UNO.
    //
    // Varias reglas dejan a cualquier sesión tocar los contadores de documentos
    // ajenos, y tienen que dejarlo: dar un like o unirse a una comunidad mueve
    // un número que vive en el documento de otra persona, y hoy eso lo escribe
    // el cliente. Lo que no puede ser es que «mover un contador» signifique
    // «escribir el número que me dé la gana»: con la regla anterior se podía
    // poner `agreementCount: 0` en cualquier publicación o `followers: 9999999`
    // en cualquier perfil, y eso no es un contador mal llevado, es corrupción.
    //
    // Esto no lo convierte en un contador de verdad —para eso hay que contarlo
    // en el servidor, y ese es su momento, no este—. Lo que hace es acotar el
    // daño a lo que la operación legítima hace: uno arriba o uno abajo, entero,
    // y nunca por debajo de cero.
    function contadorSano(campo) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([campo])
        || (request.resource.data.get(campo, 0) is int
            && request.resource.data.get(campo, 0) >= 0
            && (request.resource.data.get(campo, 0) - resource.data.get(campo, 0)) in [1, -1]);
    }

    // Encuestas (Bloque A): el campo `poll` de un post NO lo escribe el cliente.
    // Ni un tercero, ni el propio autor. Los contadores solo los mueve la callable
    // `votePoll`, que corre con el Admin SDK y no pasa por estas reglas. Publicar
    // la encuesta sigue siendo parte del `create` del post, que esto no toca.
    function touchesPoll() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll']);
    }

    // LA VISIBILIDAD DE UN POST TIENE QUE SER UN BOOLEANO DE VERDAD.
    //
    // Hasta ahora solo lo garantizaba TypeScript, y TypeScript no llega a la
    // base de datos: un script, otro cliente o una llamada suelta al SDK podían
    // guardar un post sin `isPrivate`, con `null` o con la cadena "false". La
    // página pública de `/post/{postId}` solo enseña lo que se declara público,
    // así que un campo ausente no filtraba nada... pero tampoco tiene por qué
    // llegar a existir. Se corta en el origen.
    //
    // NO se exige que valga `false`: `true` es igual de válido, porque las
    // publicaciones privadas llegarán. Lo que no se admite es no decirlo.
    function visibilidadDeclarada() {
      return request.resource.data.isPrivate is bool;
    }

    // Autoría real de un post, para las DOS caras de una misma cuenta.
    //
    // Hubo una tercera —el Perfil Biz— con su propia comprobación de dueño
    // contra `businesses`. Esa identidad se eliminó: un negocio es una Página
    // de la cuenta, no una cara de la persona.
    //
    // Y conviene decirlo: varias reglas de abajo admitían CUALQUIER `biz_*` sin
    // comprobar propiedad alguna, así que quitarlas no solo limpia — cierra un
    // hueco por el que cualquiera con sesión podía escribir como el negocio de
    // otra persona.
    function ownsPost() {
      return resource.data.userId == request.auth.uid ||
        resource.data.userId == ("hidi_" + request.auth.uid);
    }

    // === USUARIOS ===
    //
    // ⚠ DEUDA CONOCIDA: ESTE DOCUMENTO MEZCLA LA CUENTA Y EL PERFIL.
    //
    // `allow read: if true` es correcto para un perfil público —nombre, foto,
    // bio— y es lo que el muro necesita para pintar a quien publicó, incluso
    // sin sesión. El problema es lo que comparte documento con eso: `email`,
    // `realName`, `birthDate`, `gender`, `creditsBalance` y `linkedAccountId`
    // están en el MISMO documento, y Firestore no sabe ocultar campos: quien
    // puede leer un documento lo lee entero.
    //
    // `linkedAccountId` es el peor: es el vínculo entre el Perfil Weë y la
    // cuenta real, así que leerlo deshace la separación de identidades que es
    // la razón de ser del Perfil Weë.
    //
    // NO SE ARREGLA CON UNA REGLA, y por eso aquí solo queda la costura. Se
    // arregla separando lo que nunca debió estar junto: el perfil público en
    // `users/{uid}` y lo de la cuenta en `users/{uid}/private/**`, que ya está
    // declarado abajo y solo lee su dueño. Eso es una migración de datos y un
    // cambio en quien lee y escribe esos campos — pertenece a la fase que
    // cablea Identity a producción, que es justo donde el modelo canónico
    // (Account ≠ Perfil) deja de ser contrato y pasa a ser esquema.
    match /users/{userId} {
      // Cualquiera puede leer perfiles públicos
      allow read: if true;

      // Solo el dueño puede crear/actualizar su perfil
      // Permite crear perfil real (uid == auth.uid) o Perfil Weë (uid == "hidi_" + auth.uid).
      //
      // EL PERFIL REAL SE CREA EN `users/<uid>` Y EN NINGÚN OTRO SITIO (Fase 11.x).
      // Con id automático, dos arranques a la vez creaban dos perfiles para la
      // misma cuenta. Con el id atado a la cuenta, dos creaciones chocan en el
      // mismo documento y solo pasa una. El id NO es la identidad: la identidad
      // sigue siendo el campo `uid`, y los perfiles antiguos con id automático
      // se siguen leyendo y actualizando igual. El Perfil Weë conserva su forma.
      //
      // Y el Perfil Real nace con el mismo `linkedAccountId` que podría ponerse
      // después (Fase 11.x-4A): ninguno, o el de su propia cara Weë. Antes solo
      // se vigilaba al actualizar y se podía nacer ya apuntando a una cara ajena.
      allow create: if isAuthenticated() && !createsCreditFields() && !createsEcontactFields() && !createsAccountFields() &&
        !createsIdentityCoreFields() &&
        ((request.auth.uid == request.resource.data.uid && userId == request.auth.uid &&
          (!('profileType' in request.resource.data) || request.resource.data.profileType == 'real') &&
          (!('linkedAccountId' in request.resource.data) ||
           request.resource.data.linkedAccountId == ("hidi_" + request.auth.uid))) ||
         (request.resource.data.uid == ("hidi_" + request.auth.uid) &&
          userId == request.resource.data.uid &&
          request.resource.data.profileType == 'hidi' &&
          request.resource.data.linkedAccountId == request.auth.uid));

      // Solo el dueño, y nadie más.
      //
      // Había una tercera rama que dejaba a CUALQUIER sesión escribir
      // `followers`/`following` en el perfil de CUALQUIER persona. Existía para
      // que seguir a alguien pudiera mover su contador desde el cliente, pero
      // el sistema de follows es código muerto —570 líneas sin una sola
      // pantalla que las use, sustituido por ËContact— así que la rama no
      // servía a nada vivo y sí permitía escribirle a otro `followers: 9999999`.
      allow update: if isAuthenticated() && !touchesCreditFields() && !touchesEcontactFields() && !touchesAccountFields() &&
        !touchesIdentityFields() && linkedAccountIdValido() && !touchesIdentityCoreFields() &&
        (request.auth.uid == resource.data.uid ||
         (resource.data.uid == ("hidi_" + request.auth.uid) &&
          resource.data.profileType == 'hidi'));

      allow delete: if false; // No permitir eliminar usuarios

      // LO DE LA CUENTA, QUE NO ES PÚBLICO Y NUNCA DEBIÓ SERLO.
      //
      // El destino de `email`, `realName`, `birthDate`, `gender`,
      // `linkedAccountId` y el saldo. Hoy está vacío: la regla existe para que
      // el sitio correcto ya esté cerrado cuando esos campos se muden, y para
      // que a nadie se le ocurra inventarse otro. Solo su dueño, y el servidor
      // por encima de todo esto.
      //
      // EL DUEÑO SE RECONOCE POR EL CAMPO `uid` DEL PERFIL, NO POR EL ID DEL
      // DOCUMENTO: los perfiles tienen id automático, así que comparar
      // `request.auth.uid` con `userId` no acertaba nunca y nadie podía leer
      // lo suyo. El dueño escribe SOLO los campos de cuenta que el registro
      // recoge; el servidor, por encima de las reglas, escribe lo que haga falta.
      function esDuenyoDelPerfil(idDePerfil) {
        return isAuthenticated() &&
          get(/databases/$(database)/documents/users/$(idDePerfil)).data.uid == request.auth.uid;
      }
      function camposPrivadosDeCuenta() {
        return ['realName', 'birthDate', 'gender', 'updatedAt'];
      }
      match /private/{documento} {
        allow read: if esDuenyoDelPerfil(userId);
        allow create, update: if esDuenyoDelPerfil(userId) && documento == 'account' &&
          request.resource.data.keys().hasOnly(camposPrivadosDeCuenta());
        allow delete: if false;
      }

      // Guardados: solo el dueño lee y escribe sus marcadores
      match /bookmarks/{postId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // "Mis documentos" de Weë Writer: solo el dueño
      match /writerDocuments/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // === COMUNIDADES ===
    match /communities/{communityId} {
      // Cualquiera puede leer comunidades
      allow read: if true;

      // QUIÉN CREÓ UNA COMUNIDAD LO DICE LA SESIÓN, NO EL DOCUMENTO (Fase 11.x-4A).
      //
      // Decía `if isAuthenticated()` a secas: `createdBy` y `moderators` los
      // ponía el cliente, y son justo lo que después decide quién la edita. Se
      // podía crear una comunidad a nombre de otra persona, o darse por
      // moderador de una que nunca fue suya.
      //
      // Una comunidad de usuario la crea la CUENTA —como un negocio: es de la
      // cuenta, no de una cara—, que queda de creadora y de única moderadora,
      // y nace con los contadores a cero (o con su creador ya dentro). Las
      // oficiales no las crea nadie desde la app: solo una sesión con el claim
      // `admin`, que es quien siembra el catálogo.
      function comunidadDeUsuario() {
        return request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.moderators == [request.auth.uid] &&
          request.resource.data.get('isOfficial', false) == false &&
          request.resource.data.get('memberCount', 0) in [0, 1] &&
          request.resource.data.get('postCount', 0) == 0;
      }
      function comunidadOficialDeAdministracion() {
        return request.auth.token.get('admin', false) == true &&
          request.resource.data.get('isOfficial', false) == true;
      }
      allow create: if isAuthenticated() && (comunidadDeUsuario() || comunidadOficialDeAdministracion());

      // La autoría no se reescribe: `createdBy` e `isOfficial` son de por vida,
      // y la lista de moderadores solo la cambia quien la creó.
      function tocaLaAutoriaDeLaComunidad() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'isOfficial']) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderators']) &&
           resource.data.get('createdBy', '') != request.auth.uid);
      }

      // Solo moderadores pueden actualizar la comunidad
      // O cualquier usuario autenticado puede actualizar contadores, de uno en uno
      allow update: if isAuthenticated() && !tocaLaAutoriaDeLaComunidad() &&
        (request.auth.uid in resource.data.moderators ||
         resource.data.get('createdBy', '') == request.auth.uid ||
         (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['memberCount', 'postCount', 'updatedAt'])
          && contadorSano('memberCount') && contadorSano('postCount')));

      allow delete: if false; // No permitir eliminar comunidades

      // Subcolección de miembros (real o HIDI). El documento se llama como la
      // identidad que se une, y dice ser esa misma identidad: no otra.
      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId) &&
          request.resource.data.get('userId', memberId) == memberId;
        allow update: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId) &&
          request.resource.data.get('userId', memberId) == memberId;
        allow delete: if isAuthenticated() &&
          (request.auth.uid == memberId || ("hidi_" + request.auth.uid) == memberId);
      }
    }

    // === POSTS ===
    match /posts/{postId} {
      // Cualquiera puede leer posts públicos
      allow read: if true;

      // Solo usuarios autenticados pueden crear posts.
      // Se publica con la identidad real o con la Weë (hidi), y SIEMPRE tienen
      // que ser identidades de esta misma cuenta.
      allow create: if isAuthenticated() && visibilidadDeclarada() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid));

      // El autor puede actualizar su post, o cualquier usuario autenticado puede actualizar contadores.
      // `poll` queda fuera de los dos caminos: los votos solo los escribe el servidor.
      //
      // `visibilidadDeclarada()` mira el documento RESULTANTE, no el cambio: de
      // nada serviría exigirlo al crear si después una actualización pudiera
      // borrar el campo o cambiarle el tipo. Vale para los dos caminos, también
      // para el de los contadores, que no tiene por qué tocarlo.
      //
      // LA AUTORÍA NO SE EDITA (Fase 11.x-4A). `ownsPost()` mira el documento
      // que HABÍA; sin esto, el autor podía escribir otro `userId` en el que
      // quedaba y regalarle —o endosarle— su publicación a cualquiera, y la
      // página pública lo habría enseñado como autor. Tampoco se convierte un
      // repost en otra cosa ni se cambia su original, ni se mueve la fecha de
      // creación para colarse arriba del muro. Real y Weë siguen publicando y
      // editando igual: esto no mira con qué cara se firmó, solo que no cambie.
      allow update: if isAuthenticated() && !touchesPoll() && visibilidadDeclarada() && (
        (ownsPost() && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['userId', 'isRepost', 'originalPostId', 'createdAt'])) ||
        // Permitir actualizar solo contadores (views, agreementCount, etc.),
        // y solo de uno en uno: ver `contadorSano`.
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'agreementCount', 'disagreementCount', 'likes', 'comments', 'shares', 'reposts', 'updatedAt'])
         && contadorSano('views') && contadorSano('agreementCount')
         && contadorSano('disagreementCount') && contadorSano('likes')
         && contadorSano('comments') && contadorSano('shares') && contadorSano('reposts'))
      );

      // Solo el autor puede eliminar su post
      allow delete: if isAuthenticated() && ownsPost();

      // === ENCUESTAS: el voto de cada persona, en su propio documento ===
      // Lo escribe únicamente la callable `votePoll` (Admin SDK). Cada quien lee
      // el suyo y solo el suyo: nadie puede saber qué votó otra persona.
      match /pollVotes/{voterUid} {
        allow read: if isAuthenticated() && request.auth.uid == voterUid;
        allow write: if false;
      }
    }

    // === VOTOS ===
    // UNA CUENTA, UN VOTO.
    //
    // El identificador del documento es `{userId}_{postId}`, así que con las
    // dos caras salían DOS documentos para la misma persona y el mismo post:
    // `abc_p1` y `hidi_abc_p1`. Y salían de verdad — en producción hay ocho
    // votos con identidad Weë—, con el agravante de que cada pantalla usaba una
    // cosa distinta: el muro votaba con la cara activa y el detalle con la
    // cuenta, así que el propio voto aparecía y desaparecía según por dónde se
    // mirara.
    //
    // La unidad de participación correcta aquí es la CUENTA, y no es una
    // decisión nueva: es la misma que ya tomaron las encuestas —`votePoll` usa
    // siempre `request.auth.uid`, y está escrito allí que Real y Weë comparten
    // un voto—. Un acuerdo no es contenido firmado por una identidad: es una
    // señal sobre una publicación, y una persona tiene una.
    //
    // `update` y `delete` siguen admitiendo la forma antigua A PROPÓSITO: los
    // ocho votos que ya existen tienen que poder deshacerse por su dueño. Lo
    // que no se puede es crear más.
    //
    // Y UN VOTO ES DE QUIEN LO EMITE, EN SU DOCUMENTO (Fase 11.x-4A). Al crear,
    // el id tiene que ser `{cuenta}_{publicación}`: con cualquier otro id la
    // misma persona podía abrir tantos votos como quisiera sobre la misma
    // publicación. Al cambiarlo solo se mueven `type` y `createdAt`: ni el
    // votante ni la publicación cambian, así que nadie se apropia de un voto
    // ajeno ni muda el suyo a otra publicación.
    function tipoDeVotoValido() {
      return request.resource.data.type in ['agree', 'disagree'];
    }
    match /votes/{voteId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.postId is string &&
        voteId == request.auth.uid + '_' + request.resource.data.postId &&
        tipoDeVotoValido();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'createdAt']) &&
        tipoDeVotoValido();
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid));
    }

    // === VOTOS DE COMENTARIOS ===
    // Lo mismo que en `votes`, y por lo mismo. El cliente ya votaba comentarios
    // con la cuenta (`CommentCard`), así que aquí la regla solo lo hace cumplir.
    match /commentVotes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.commentId is string &&
        voteId == 'comment_' + request.auth.uid + '_' + request.resource.data.commentId &&
        tipoDeVotoValido();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'createdAt']) &&
        tipoDeVotoValido();
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid));
    }

    // === COMENTARIOS ===
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid));

      // El autor edita su comentario, pero no su autoría (Fase 11.x-4A): ni de
      // quién es, ni de qué publicación cuelga, ni a quién responde, ni cuándo
      // se escribió. Por la misma razón que en `posts`.
      allow update: if isAuthenticated() && (
        ((resource.data.userId == request.auth.uid ||
          resource.data.userId == ("hidi_" + request.auth.uid)) &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['userId', 'postId', 'parentCommentId', 'createdAt'])) ||
        // Permitir actualizar contadores, de uno en uno
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'agreementCount', 'disagreementCount'])
         && contadorSano('likes') && contadorSano('agreementCount')
         && contadorSano('disagreementCount'))
      );

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid));
    }

    // === LIKES (legacy, mantener para retrocompatibilidad) ===
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userId == ("hidi_" + request.auth.uid));
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.userId == ("hidi_" + request.auth.uid));
    }

    // === ËCONTACT ===
    //
    // Una conexión MUTUA entre dos personas, en UN SOLO documento cuyo id es la
    // pareja ordenada: `{uidMenor}_{uidMayor}`. Al ser el mismo id se pida desde
    // el lado que se pida, no puede haber dos filas para la misma relación.
    //
    // Nace como `pending` y solo quien la recibió puede convertirla en
    // `accepted`. Nadie puede fabricar una conexión aceptada de un tirón.
    //
    // La identidad es SIEMPRE `request.auth.uid`, nunca el perfil activo: Real,
    // Weë y Biz son la misma persona y comparten una sola lista.
    // === ËCONTACT / ẄCONTACT ===
    //
    // Conexiones entre IDENTIDADES DE PERFIL, no entre cuentas. Una cuenta tiene
    // hasta dos caras de persona y cada una lleva su propia agenda:
    //
    //     Perfil Real  (uid == auth.uid)           →  ËContact
    //     Perfil Weë   (uid == "hidi_" + auth.uid) →  ẄContact
    //
    // Las cuatro combinaciones son válidas —real↔real, real↔Weë, Weë↔real y
    // Weë↔Weë— y cada una es UN SOLO documento.
    match /econtacts/{contactId} {
      // Las identidades que puede usar esta sesión. Se derivan del uid de la
      // cuenta, que es exactamente como se construyen los perfiles: el Perfil Weë
      // de la cuenta ABC es "hidi_ABC" y no puede ser otro.
      function misIdentidades() {
        return [request.auth.uid, 'hidi_' + request.auth.uid];
      }
      // ¿Participa alguno de MIS perfiles en esta relación?
      function participo() {
        return resource.data.users.hasAny(misIdentidades());
      }

      // Una relación es asunto de sus dos partes y de nadie más. Se lee con
      // cualquiera de tus dos perfiles: es la misma persona quien pregunta.
      allow read: if isAuthenticated() && participo();

      // PEDIR Y ACEPTAR SON DEL SERVIDOR. LAS DOS.
      //
      // Aceptar, porque es la transición que CREA la conexión y no se deja en
      // manos de quien puede modificar su propia app.
      //
      // Pedir, porque hay que comprobar DE QUIÉN ES CADA IDENTIDAD, y eso se lee
      // de `users`. Desde aquí no se puede: los documentos de `users` tienen id
      // automático y se buscan por el campo `uid`; una regla puede hacer `get()`
      // de una ruta, pero no una consulta. Lo único comprobable aquí sería el
      // prefijo del uid, o sea lo que AFIRMA el cliente. Y hay una segunda cosa
      // que solo el servidor puede ver: que el perfil de destino exista de verdad.
      //
      // Las dos las hacen `requestEContact` y `acceptEContact`, con el Admin SDK
      // —que no pasa por estas reglas— y dentro de una transacción.
      //
      // Es el mismo reparto que en las encuestas: el cliente propone, el servidor
      // decide y escribe.
      allow create: if false;
      allow update: if false;

      // Las tres salidas son borrados, y todas las hace quien participa:
      //   · cancelar  → quien la envió retira su solicitud pendiente
      //   · rechazar  → quien la recibió dice que no
      //   · eliminar  → cualquiera de las dos deshace una conexión aceptada
      // No hay estado `rejected`: sin documento, la relación no existe y se
      // puede volver a intentar.
      //
      // Esto sí se puede comprobar aquí, porque no hace falta saber de quién es
      // una identidad: basta con que una de las TUYAS esté en el documento que ya
      // está guardado.
      allow delete: if isAuthenticated() && participo() &&
        (resource.data.status == 'pending' || resource.data.status == 'accepted');
    }

    // === FOLLOWS ===
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.followerId == request.auth.uid ||
         request.resource.data.followerId == ("hidi_" + request.auth.uid));
      allow delete: if isAuthenticated() &&
        (resource.data.followerId == request.auth.uid ||
         resource.data.followerId == ("hidi_" + request.auth.uid));
    }

    // === CONVERSACIONES ===
    //
    // QUIÉN HABLA LO DICE LA SESIÓN (Fase 11.x-4A). Antes cualquier
    // participante podía reescribir la conversación ENTERA: cambiar
    // `participants` —meter a quien quisiera, o sacar a la otra persona y
    // quedarse con el historial—, firmar `lastMessage` con otra identidad, y
    // editar el texto de los mensajes AJENOS. Y `participants` no es un dato
    // cualquiera: lo leen `burnViewOnce`, el push de mensajes y las reglas del
    // Storage de la foto única para decidir quién entra.
    //
    // Ahora `participants` se fija al crear y no se toca más; se firma con una
    // identidad propia que participa; y un mensaje, una vez escrito, solo
    // cambia en lo que la app hace de verdad: marcarse como leído, o vaciarse
    // en el modo efímero. Las cuatro combinaciones Real/Weë siguen valiendo
    // igual: nada de esto mira con qué cara se habla, solo que sea tuya.
    match /conversations/{conversationId} {
      function misIdentidadesDeChat() {
        return [request.auth.uid, 'hidi_' + request.auth.uid];
      }
      function participo() {
        return resource.data.participants.hasAny(misIdentidadesDeChat());
      }

      // Solo participantes pueden leer
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants ||
         ("hidi_" + request.auth.uid) in resource.data.participants);

      // Una conversación es entre DOS identidades, una de ellas mía, y su ficha
      // de participantes habla exactamente de esas dos. Es lo que la app crea.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['participants', 'participantsData', 'createdAt', 'updatedAt']) &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        request.resource.data.participants.hasAny(misIdentidadesDeChat()) &&
        request.resource.data.participantsData is map &&
        request.resource.data.participantsData.keys().toSet() == request.resource.data.participants.toSet();

      // `lastMessage` cambia de tres maneras, y solo de esas tres: lo firma una
      // identidad MÍA que participa (acabo de escribir); se marca como leído
      // sin tocar nada más; o lo vacía el modo efímero, que no firma nadie.
      function ultimoMensajeLegitimo() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage']) ||
          (request.resource.data.lastMessage is map && (
            (request.resource.data.lastMessage.get('senderId', '') in misIdentidadesDeChat() &&
             request.resource.data.lastMessage.get('senderId', '') in resource.data.participants) ||
            (resource.data.get('lastMessage', null) is map &&
             request.resource.data.lastMessage.diff(resource.data.lastMessage).affectedKeys().hasOnly(['read']) &&
             request.resource.data.lastMessage.get('read', false) == true) ||
            (resource.data.get('ephemeral', false) == true &&
             request.resource.data.lastMessage.get('senderId', null) == '')));
      }
      // Quién está mirando el chat: cada uno entra y sale él mismo, no mueve al otro.
      function presenciaPropia() {
        let antes = resource.data.get('activeInChat', []).toSet();
        let despues = request.resource.data.get('activeInChat', []).toSet();
        return despues.difference(antes).union(antes.difference(despues)).hasOnly(misIdentidadesDeChat());
      }
      // El color de burbuja es de cada uno: solo el suyo.
      function colorPropio() {
        return request.resource.data.get('bubbleColors', {}).diff(resource.data.get('bubbleColors', {}))
          .affectedKeys().hasOnly(misIdentidadesDeChat());
      }

      allow update: if isAuthenticated() && participo() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt', 'activeInChat', 'bubbleColors', 'chatTheme', 'chatWallpaper', 'ephemeral']) &&
        ultimoMensajeLegitimo() && presenciaPropia() && colorPropio();

      allow delete: if false;

      // Mensajes dentro de conversaciones — solo participantes de la conversación padre
      match /messages/{messageId} {
        function participantesDelChat() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function participoEnElChat() {
          return participantesDelChat().hasAny(misIdentidadesDeChat());
        }
        // El remitente es una identidad MÍA y además una de las que participan:
        // no se escribe con la cara que no está en la conversación.
        function remitenteLegitimo() {
          let remitente = request.resource.data.get('senderId', '');
          return remitente in misIdentidadesDeChat() && remitente in participantesDelChat();
        }
        // El modo efímero vacía un mensaje efímero; no reescribe ninguno.
        function vaciadoEfimero() {
          return resource.data.get('ephemeral', false) == true &&
            request.resource.data.get('ephemeral', false) == true &&
            request.resource.data.get('deleted', false) == true &&
            request.resource.data.get('content', '') == '' &&
            request.resource.data.get('imageUrl', null) == null;
        }

        allow read: if isAuthenticated() && participoEnElChat();

        allow create: if isAuthenticated() && remitenteLegitimo() &&
          request.resource.data.get('conversationId', conversationId) == conversationId;

        // Lo único que un participante cambia de un mensaje: marcarlo como
        // leído, o vaciarlo en el modo efímero. El remitente, el texto de un
        // mensaje normal, sus archivos y su fecha no los reescribe nadie.
        allow update: if isAuthenticated() && participoEnElChat() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'content', 'deleted', 'imageUrl', 'ephemeral']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['read']) ||
           request.resource.data.read == true) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['content', 'deleted', 'imageUrl', 'ephemeral']) ||
           vaciadoEfimero());

        allow delete: if false;
      }
    }

    // === REPORTES ===
    match /reports/{reportId} {
      // Solo el reporter puede crear, nadie puede leer (solo admin via console)
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // === BUSINESS FOLLOWS (WeeBiz) ===
    match /businessFollows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // === BUSINESSES (WeeBiz) ===
    match /businesses/{businessId} {
      // Cualquiera puede leer negocios
      allow read: if true;

      // Solo usuarios autenticados pueden crear un negocio
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      // Solo el dueño puede actualizar su negocio, o cualquiera puede actualizar contadores.
      //
      // `followersCount` se acota de uno en uno como los demás. `auraScore` y
      // `reviewCount` NO se pueden acotar así: son un promedio y un recuento
      // que el cliente RECALCULA leyendo hasta mil reseñas, así que saltan a
      // cualquier valor por diseño. Aquí solo se les exige que sean números
      // dentro de su rango; que nadie pueda ponerle un 5 al negocio que quiera
      // exige contar en el servidor, y eso es de la fase de Weë Business.
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followersCount', 'auraScore', 'reviewCount'])
          && contadorSano('followersCount')
          && request.resource.data.get('auraScore', 0) >= 0
          && request.resource.data.get('auraScore', 0) <= 5
          && request.resource.data.get('reviewCount', 0) is int
          && request.resource.data.get('reviewCount', 0) >= 0
      );

      allow delete: if false;

      // Reseñas del negocio
      match /reviews/{reviewId} {
        allow read: if true;

        // Solo usuarios autenticados pueden crear una reseña (no el dueño a sí mismo)
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;

        // Solo el autor puede eliminar su reseña
        allow delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;

        allow update: if false;
      }

      // Productos del negocio
      match /products/{productId} {
        allow read: if true;

        // Solo el dueño del negocio puede crear/editar/eliminar productos
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }
    }

    // === CREDIT ENGINE (docs/CREDITS.md) ===
    // Historial de Credits: cada persona lee el suyo; escribe solo el servidor.
    match /creditTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === TOKENS DE PUSH: UN SECRETO DEL APARATO, NUNCA EN UN PERFIL PÚBLICO ===
    //
    // Con un token de Expo cualquiera puede mandar avisos a ese teléfono, así
    // que no puede vivir en `users`, que lo lee todo el mundo. El documento se
    // llama como la CUENTA (uid de Firebase Auth): lo escribe solo su dueño y
    // no lo lee nadie desde el cliente; lo lee el servidor al enviar.
    match /pushTokens/{uid} {
      allow read: if false;
      allow create, update: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 300;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }
    // Acumulados para administración: solo servidor / consola
    match /creditStats/{statId} {
      allow read, write: if false;
    }
    // Sobreescritura de costos (administración): la app los consulta por Cloud Function
    match /creditCosts/{costId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // === WALLETS / TRANSACTIONS (billetera anterior, solo lectura) ===
    // Migrada al Credit Engine (users.creditsBalance + creditTransactions).
    // Se conserva de solo lectura hasta que la migración termine; nadie escribe.
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && request.auth.uid == walletId;
      allow write: if false;
    }
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === NOTIFICACIONES ===
    match /notifications/{notificationId} {
      // Solo el destinatario puede leer sus notificaciones (real, HIDI o BIZ)
      allow read: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid));

      // El remitente tiene que ser QUIEN ESCRIBE, no quien diga el documento.
      //
      // Decía `if isAuthenticated()` a secas, sin mirar `senderId`. Y una
      // notificación no se queda en la base de datos: dispara un push de verdad
      // (`functions/src/index.ts`), cuyo título sale de `senderName` tal cual
      // llega. Es decir: cualquiera con sesión podía hacerle llegar a cualquier
      // otra persona un aviso firmado por quien quisiera.
      //
      // Las dos caras valen, como en posts y comentarios: se avisa desde la
      // identidad con la que se actuó. Lo que no vale es firmar con una ajena.
      allow create: if isAuthenticated() &&
        (request.resource.data.senderId == request.auth.uid ||
         request.resource.data.senderId == ("hidi_" + request.auth.uid));

      // Solo el destinatario puede actualizar (marcar como leída)
      allow update: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid));

      // Solo el destinatario puede eliminar sus notificaciones
      allow delete: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid ||
         resource.data.recipientId == ("hidi_" + request.auth.uid));
    }

    // === INTERÉS EN AI APPS (WEE Creator: "Avísame cuando esté") ===
    // Un documento por persona y categoría: {uid}_{categoryId}
    match /creatorInterests/{interestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        interestId == request.auth.uid + '_' + request.resource.data.categoryId;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // === WEE CREATOR: TRABAJOS ===
    // Los escribe solo el servidor (Cloud Functions); la persona lee los suyos.
    match /creatorJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      // La persona solo puede mover su creación a un proyecto
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectId', 'updatedAt']);

      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Catálogo y precios de WEE Creator: solo servidor / consola
    match /capabilities/{capabilityId} {
      allow read, write: if false;
    }
    match /pricing/{capabilityId} {
      allow read, write: if false;
    }

    // === WEË AI ENGINE (docs/AI-ENGINE.md) ===
    // Configuración de proveedores, cadenas de fallback y ajustes: solo servidor / consola
    match /aiProviders/{providerId} {
      allow read, write: if false;
    }
    match /aiRouting/{capabilityId} {
      allow read, write: if false;
    }
    match /aiSettings/{settingId} {
      allow read, write: if false;
    }
    match /aiUsage/{day} {
      allow read, write: if false;
    }
    // Libro de generaciones: cada persona lee las suyas; escribe solo el servidor
    match /aiGenerations/{generationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // Límites de uso por persona y día: solo servidor
    match /aiRateLimits/{limitId} {
      allow read, write: if false;
    }
    // Avisos del webhook de Seedance (BytePlus): los escribe la Cloud Function con
    // el Admin SDK, que no pasa por estas reglas. El cliente no lee ni escribe.
    match /aiProviderCallbacks/{taskId} {
      allow read, write: if false;
    }
    // Verificación de proveedores contra su API real: solo servidor y panel de administración
    match /aiProviderVerification/{providerId} {
      allow read, write: if false;
    }

    // === WEË BRAIN: conversaciones ===
    // La persona lee sus conversaciones y mensajes; escribe solo el servidor (brainChat)
    match /brainChats/{chatId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/brainChats/$(chatId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // === WEË BRAIN: EL BLOQUE DE DOCE RESPUESTAS ===
    // Cerrado de los dos lados. El contador decide cuándo se cobra un Credit, así
    // que dejarlo leer o escribir desde el teléfono sería dejar que la persona se
    // ponga el contador a cero. Lo mueve solo el servidor, dentro de una
    // transacción, y lo que la pantalla necesita saber —"7/12"— se lo devuelven
    // las callables brainQuote y brainChat, ya calculado.
    match /brainUsage/{userId} {
      allow read, write: if false;
      match /respuestas/{messageId} {
        allow read, write: if false;
      }
    }

    // === IDENTITY CORE (Fase 11.x-2): la cuenta con nombre, sus entidades y el contador ===
    //
    // Lo escribe solo el servidor: nacer una cuenta reparte una posición de una
    // serie, y eso no puede hacerlo un cliente. La cuenta la lee su dueño; una
    // entidad, la cuenta que la posee; el contador, nadie desde fuera.
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && request.auth.uid == accountId;
      allow write: if false;
    }
    match /entities/{entityId} {
      allow read: if isAuthenticated() && resource.data.ownerAccountId == request.auth.uid;
      allow write: if false;
    }
    match /contadores/{contador} {
      allow read, write: if false;
    }

    // === MATERIAL (Content Core, Fase 11) ===
    //
    // La ficha de cada archivo que Weë guarda: de quién es, dónde están los
    // bytes, cómo se hizo y en qué estado está. Cada cuenta lee lo suyo y solo
    // lo suyo, con consulta paginada por `ownerAccountId`.
    //
    // NO se escribe desde el cliente. Crear una ficha es decir «estos bytes son
    // de esta cuenta», y eso lo afirma el servidor a partir de la sesión, nunca
    // un documento que llega de fuera con el `ownerAccountId` que quiera.
    // Borrar tampoco: se pide con `deleteAsset`, que borra el objeto además de
    // la ficha, y comprueba antes que sea tuyo.
    match /assets/{assetId} {
      allow read: if isAuthenticated() && resource.data.ownerAccountId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // === WEË CREATOR: PROYECTOS ("Mis proyectos") ===
    match /creatorProjects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // El dueño edita lo suyo y NO puede cambiar de dueño: la regla miraba
      // solo el documento que había (`resource.data`) y dejaba escribir otro
      // `userId` en el nuevo, así que un proyecto se podía regalar o perder
      // por accidente. Un proyecto es de la cuenta y ahí se queda.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
