{
  "version": 1,
  "dominio": "router",
  "descripcion": "Casos deterministas de la decisión del Model Router vivo (engine/router.ts route()). Mundo sintético: proveedores/cadenas/uso, sin datos de personas. Coste $0: route() no ejecuta adaptadores.",
  "casos": [
    {
      "evalCaseId": "router-cadena-manda",
      "name": "La cadena manda sobre la puntuación",
      "description": "Con cadena ['a'], gana a aunque b puntúe más; b ni aparece.",
      "capability": "text.generate",
      "world": { "providers": [ { "id": "a", "priority": 10, "models": [ { "id": "a1", "quality": 3, "speed": 3, "usd": 0.02 } ] }, { "id": "b", "priority": 20, "models": [ { "id": "b1", "quality": 5, "speed": 5, "usd": 0.001 } ] } ], "routing": { "chain": ["a"], "policy": "balanced" } },
      "request": {},
      "expected": { "status": "routed", "chosen": { "provider": "a", "model": "a1" }, "orden": ["a"], "politica": true },
      "tags": ["routing", "policy"]
    },
    {
      "evalCaseId": "router-sin-cadena-prioridad",
      "name": "Sin cadena, orden por prioridad",
      "description": "Sin cadena configurada, todos los reales por prioridad; gana el de menor prioridad numérica.",
      "capability": "text.generate",
      "world": { "providers": [ { "id": "a", "priority": 10, "models": [ { "id": "a1", "quality": 3, "speed": 3, "usd": 0.02 } ] }, { "id": "b", "priority": 20, "models": [ { "id": "b1", "quality": 5, "speed": 5, "usd": 0.001 } ] } ], "routing": { "policy": "balanced" } },
