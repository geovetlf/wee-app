{
  "displayName": "Weë · errores 5xx en las Functions",
  "documentation": {
    "content": "Más de 10 respuestas 5xx en 10 minutos en los servicios de las Functions. Mira los logs del servicio y, si vino de un despliegue, la marcha atrás (docs/DEPLOYMENT.md §5).",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Weë · errores 5xx en las Functions",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND metric.label.response_code_class=\"5xx\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 10,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ]
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  }
}
